{
  "schema_version": 1,
  "model": "gpt-6-luna",
  "effort": "medium",
  "marker": "RTK-CONTEXT-AUTHORED-V1",
  "steps": [
    {
      "name": "read_file",
      "arguments": {
        "path": "source.txt",
        "start_line": 2,
        "max_lines": 1
      }
    },
    {
      "name": "exec",
      "arguments": {
        "argv": [
          "python3",
          "-B",
          "feedback.py"
        ]
      }
    },
    {
      "name": "read_output",
      "arguments": {
        "handle": "$observed_raw_handle"
      }
    },
    {
      "name": "read_file",
      "arguments": {
        "path": ".scratch/calls.txt"
      }
    },
    {
      "name": "write_file",
      "arguments": {
        "path": "out.txt",
        "content": "authored-context-ok\n",
        "create_new": true
      }
    }
  ]
}
