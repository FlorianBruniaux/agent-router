+#[cfg(test)]
+mod diagnostic_checks {
+    use super::*;
+    #[test]
+    fn refusal_has_numeric_errno_and_never_claims_qualification() {
+        let limits = Rlimit {
+            current: None,
+            maximum: None,
+        };
+        let text = attempt_json(
+            Resource::As,
+            8589934592,
+            8589934592,
+            limits,
+            limits,
+            Some(22),
+        );
+        assert!(text.contains("\"errno\":22"));
+        assert!(text.contains("\"applied\":false"));
+        assert!(text.contains("\"qualification\":false"));
+        assert!(text.contains("\"effective_soft\":null"));
+        assert!(!text.contains("limits-applied"));
+        assert!(!text.contains("GO"));
+        assert_eq!(failure_code(Resource::As), "setrlimit.address_space");
+    }
+    #[test]
+    fn only_exact_bounded_probe_arguments_are_accepted() {
+        let expected = EXACT_ARGS.map(OsString::from).to_vec();
+        assert!(exact_probe_args(&expected));
+        for replacement in ["none", "17179869184"] {
+            let mut changed = expected.clone();
+            changed[3] = replacement.into();
+            assert!(!exact_probe_args(&changed));
+        }
+        for replacement in ["--supervise-v1", "--"] {
+            let mut changed = expected.clone();
+            changed[10] = replacement.into();
+            assert!(!exact_probe_args(&changed));
+        }
+        let mut extra = expected.clone();
+        extra.push("/bin/true".into());
+        assert!(!exact_probe_args(&extra));
+        assert!(!exact_probe_args(&[]));
+    }
+}
