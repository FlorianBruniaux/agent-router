+// Scratch-only guard: there is no worker or supervisor entry point.
+const EXACT_ARGS: [&str; 11] = [
+    "--cpu-seconds",
+    "300",
+    "--address-space-bytes",
+    "8589934592",
+    "--max-open-files",
+    "256",
+    "--max-processes",
+    "256",
+    "--max-file-bytes",
+    "16777216",
+    "--probe",
+];
+fn exact_probe_args(args: &[OsString]) -> bool {
+    args.iter()
+        .map(OsString::as_os_str)
+        .eq(EXACT_ARGS.map(OsStr::new))
+}
+fn resource_name(resource: Resource) -> &'static str {
+    match resource {
+        Resource::Cpu => "cpu",
+        Resource::As => "address_space",
+        Resource::Nofile => "open_files",
+        Resource::Nproc => "processes",
+        Resource::Fsize => "file_size",
+        Resource::Core => "core",
+        _ => "other",
+    }
+}
+fn failure_code(resource: Resource) -> &'static str {
+    match resource {
+        Resource::Cpu => "setrlimit.cpu",
+        Resource::As => "setrlimit.address_space",
+        Resource::Nofile => "setrlimit.open_files",
+        Resource::Nproc => "setrlimit.processes",
+        Resource::Fsize => "setrlimit.file_size",
+        _ => "setrlimit",
+    }
+}
+fn limit_number(value: Option<u64>) -> String {
+    value.map_or_else(|| "null".into(), |v| v.to_string())
+}
+fn emit_limit(phase: &str, resource: Resource, limit: Rlimit) {
+    println!(
+        "{{\"diagnostic\":true,\"event\":\"limit\",\"phase\":\"{phase}\",\"pid\":{},\"resource\":\"{}\",\"soft\":{},\"hard\":{}}}",
+        std::process::id(),
+        resource_name(resource),
+        limit_number(limit.current),
+        limit_number(limit.maximum)
+    );
+}
+fn attempt_json(
+    resource: Resource,
+    requested: u64,
+    clamped: u64,
+    before: Rlimit,
+    after: Rlimit,
+    errno: Option<i32>,
+) -> String {
+    format!(
+        "{{\"diagnostic\":true,\"event\":\"setrlimit\",\"pid\":{},\"resource\":\"{}\",\"requested\":{requested},\"clamped\":{clamped},\"before_soft\":{},\"before_hard\":{},\"effective_soft\":{},\"effective_hard\":{},\"errno\":{},\"applied\":{},\"qualification\":false}}",
+        std::process::id(),
+        resource_name(resource),
+        limit_number(before.current),
+        limit_number(before.maximum),
+        limit_number(after.current),
+        limit_number(after.maximum),
+        errno.map_or_else(|| "null".into(), |e| e.to_string()),
+        errno.is_none()
+    )
+}
+fn emit_vsz(phase: &str) {
+    // Absolute executable, empty environment, fixed numeric-only projection.
+    // One second collection deadline; at most 128 bytes read after exit.
+    let value = own_vsz_kib();
+    println!(
+        "{{\"diagnostic\":true,\"event\":\"own_vsz\",\"phase\":\"{phase}\",\"pid\":{},\"vsz_kib\":{},\"available\":{}}}",
+        std::process::id(),
+        limit_number(value),
+        value.is_some()
+    );
+}
+fn own_vsz_kib() -> Option<u64> {
+    let mut child = Command::new("/bin/ps")
+        .args(["-o", "vsz=", "-p", &std::process::id().to_string()])
+        .env_clear()
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .ok()?;
+    let started = Instant::now();
+    loop {
+        match child.try_wait() {
+            Ok(Some(status)) => {
+                if !status.success() {
+                    return None;
+                }
+                let mut output = String::new();
+                child
+                    .stdout
+                    .take()?
+                    .take(128)
+                    .read_to_string(&mut output)
+                    .ok()?;
+                return output.trim().parse().ok();
+            }
+            Ok(None) if started.elapsed() < Duration::from_secs(1) => {
+                std::thread::sleep(Duration::from_millis(5))
+            }
+            _ => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return None;
+            }
+        }
+    }
+}
